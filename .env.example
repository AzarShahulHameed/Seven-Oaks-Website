# ───────── Shared / infrastructure only. Content, theme, menus and settings live in the DB (admin dashboard). ─────────

# ── Neon (Postgres) ──
# Pooled connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (used only for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── API (Render) ──
NODE_ENV=development
PORT=4000
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-of-48+chars"
# comma-separated browser origins allowed to call the API (your Vercel domain(s))
CORS_ORIGINS="http://localhost:3000"
WEB_URL="http://localhost:3000"
# any random text, 16+ characters. Must equal REVALIDATE_SECRET on Vercel when deployed.
REVALIDATE_SECRET="change-me-another-random-string"
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=30
MAX_FAILED_LOGINS=5
LOCKOUT_MIN=15

# ── Integrations ──
# Cloudinary (images) and Resend (email) keys are NOT set here: enter them in Admin → Integrations.
# They are stored encrypted in the database with this key (generate like JWT_ACCESS_SECRET; keep it safe, losing it means re-entering the keys).
SECRETS_ENCRYPTION_KEY="change-me-another-long-random-string-32+chars"
MAX_UPLOAD_MB=4           # keep <= 4: Vercel limits proxied request bodies to about 4.5 MB

# ── Web (Vercel) ──
# Render API base URL (server side only; browser calls /api/* which Next rewrites to this)
API_URL="http://127.0.0.1:4000"
# Public site URL (used for sitemap, canonical, hreflang)
SITE_URL="http://localhost:3000"
DEFAULT_LOCALE=en

# ── Seed (first super admin; used only by `npm run db:seed`) ──
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="use-a-strong-password-min-12-chars"
SEED_ADMIN_NAME="Site Administrator"
